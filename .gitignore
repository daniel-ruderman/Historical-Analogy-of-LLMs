# Secrets -- never commit an API key
.env

# Caches produced by our extension (embeddings, Wikipedia pages)
.hal_cache/



# IDE / editor configuration -- local to each developer, never shared.
# NOTE: files already tracked before this rule was added stay tracked until
# they are removed from the index with `git rm --cached`.
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
