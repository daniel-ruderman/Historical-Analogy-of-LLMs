# Secrets -- never commit an API key
.env

# Caches produced by our extension (embeddings, Wikipedia pages)
.hal_cache/

# Large local/shared model artifacts
models/

# Forecast evaluation artifacts (see forecast_analogy_evaluation/)
forecast_analogy_evaluation/logs/
forecast_analogy_evaluation/runs/
forecast_analogy_evaluation/data/raw/
forecast_analogy_evaluation/data/cache/

# Local cluster job logs
logs/

# IDE / editor configuration -- local to each developer, never shared.
# NOTE: files already tracked before this rule was added stay tracked until
# they are removed from the index with `git rm --cached`.
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
