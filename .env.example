# Local configuration -- copy this file to `.env` and add your own API key.
#
#   .env                     your secrets + your personal overrides   (NOT committed)
#   hal/project_defaults.py  the team's shared project defaults       (committed)
#
# `.env` is git-ignored on purpose, so anything you put here stays on your
# machine and is NOT shared with your collaborators. NEVER commit a real key.
#
# You do NOT need to copy the optional values below into `.env` to run the
# project: every one of them already has a tracked default in
# hal/project_defaults.py that you receive through `git pull`.
# Uncomment a line only when you want to override the shared default locally.
#
# Resolution order:  .env / environment  >  hal/project_defaults.py  >  code fallback


# ===========================================================================
# REQUIRED SECRET -- no tracked default exists, each developer supplies their own
# ===========================================================================
# Read by the official Google Gen AI SDK (`pip install google-genai`).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ===========================================================================
# OPTIONAL OVERRIDES -- all commented out; the tracked defaults are shown
# ===========================================================================

# --- providers -------------------------------------------------------------
# Registered LLM providers:        gemini | mock
# Registered embedding providers:  gemini | mock
# Registered search providers:     wikipedia | mock | none
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# SEARCH_PROVIDER=wikipedia

# --- models ----------------------------------------------------------------
# The generation model and the embedding model are configured independently:
# changing one does not change the other.
# LLM_MODEL=gemma-4-31b-it
# EMBEDDING_MODEL=gemini-embedding-001

# Optional reduced embedding dimensionality (vectors are re-normalised, so an
# inner product still equals cosine similarity). Unset = the SDK default.
# EMBEDDING_DIMENSIONS=

# Per-role models. Each one falls back to LLM_MODEL when unset, so you normally
# do not need any of these.
# GENERATOR_MODEL=
# CRITIC_MODEL=
# ANTI_ANALOGY_MODEL=
# JUDGE_MODEL=
# SUMMARIZER_MODEL=
# BASELINE_MODEL=
# EVALUATION_MODEL=

# Gemini generation surface: auto | models | interactions
# `auto` prefers client.models.generate_content and falls back to
# client.interactions.create when the installed SDK does not expose it.
# GEMINI_API_SURFACE=auto

# --- our agentic pipeline --------------------------------------------------
# REFINEMENT_ROUNDS=2
# MAX_CANDIDATES=8
# MIN_CANDIDATES=5
# REACT_MAX_STEPS=4
# SEARCH_TOP_K=4

# --- generation settings ---------------------------------------------------
# The paper runs its baselines at temperature 0.1 (Sec. 5.1).
# LLM_TEMPERATURE=0.1
# The original evaluation.py uses an effectively greedy judge.
# EVALUATION_TEMPERATURE=0.0
# MAX_OUTPUT_TOKENS=2048

# --- quota / robustness ----------------------------------------------------
# MAX_RETRIES=5
# RETRY_BASE_DELAY=2.0
# RETRY_MAX_DELAY=60.0
# Seconds to wait before each API call (raise this if you hit per-minute limits)
# REQUEST_DELAY=0.0

# --- caching (embeddings + Wikipedia pages; never part of a result) --------
# A relative CACHE_DIR is resolved against the repository root.
# CACHE_ENABLED=true
# CACHE_DIR=.hal_cache

# --- misc ------------------------------------------------------------------
# WIKI_LANG=en
