# Copy this file to `.env` and fill in your key.
# `.env` is git-ignored. NEVER commit a real API key.

# ---------------------------------------------------------------------------
# API key
# ---------------------------------------------------------------------------
# The official Google Gen AI SDK (`pip install google-genai`) reads GEMINI_API_KEY.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# Registered LLM providers:        gemini | mock
# Registered embedding providers:  gemini | mock
# Registered search providers:     wikipedia | mock | none
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
SEARCH_PROVIDER=wikipedia

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Model availability and free-tier quotas change; check your own limits at
# https://aistudio.google.com/rate-limit before a large run.
# Nothing in the code depends on these exact strings.
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Optional: reduce the embedding dimensionality (vectors are re-normalised, so
# an inner product still equals cosine similarity). Leave empty for the default.
EMBEDDING_DIMENSIONS=

# Optional per-role models. Each one defaults to LLM_MODEL when left empty,
# so you normally only set LLM_MODEL.
GENERATOR_MODEL=
CRITIC_MODEL=
ANTI_ANALOGY_MODEL=
JUDGE_MODEL=
SUMMARIZER_MODEL=
BASELINE_MODEL=
EVALUATION_MODEL=

# Which Gemini generation surface to use: auto | models | interactions
# `auto` prefers client.models.generate_content and falls back to
# client.interactions.create when the installed SDK does not expose it.
GEMINI_API_SURFACE=auto

# ---------------------------------------------------------------------------
# Our agentic pipeline
# ---------------------------------------------------------------------------
REFINEMENT_ROUNDS=2
MAX_CANDIDATES=8
MIN_CANDIDATES=5
REACT_MAX_STEPS=4
SEARCH_TOP_K=4

# ---------------------------------------------------------------------------
# Generation settings
# ---------------------------------------------------------------------------
# The paper runs its baselines at temperature 0.1 (Sec. 5.1).
LLM_TEMPERATURE=0.1
# The original evaluation.py uses an effectively greedy judge.
EVALUATION_TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Quota / robustness
# ---------------------------------------------------------------------------
MAX_RETRIES=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0
# Seconds to wait before each API call (raise this if you hit per-minute limits)
REQUEST_DELAY=0.0

# ---------------------------------------------------------------------------
# Caching (embeddings + Wikipedia pages). Never part of a research result.
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=.hal_cache

# Wikipedia language edition
WIKI_LANG=en
